# ============================================================
# NoteSphere - Environment Configuration Template
# Duplicate this file to .env and fill in your cloud credentials
# ============================================================

# Flask Application Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key
PORT=5000

# Firebase Configuration
# Path to your Firebase service account JSON key file (relative to project root or absolute)
FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json
# Or provide the project ID directly
FIREBASE_PROJECT_ID=notesphere-mini-project

# Cloudinary Configuration (Cloud PDF Storage & Delivery)
# Find these in your Cloudinary Dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload & File Limits
MAX_CONTENT_LENGTH_MB=15

# Bootstrap Administrators (Comma-separated emails that are automatically granted admin role)
ADMIN_EMAILS=admin@notesphere.edu,admin@example.com
